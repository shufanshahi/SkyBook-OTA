@model IReadOnlyList<RefundRow>
@{ ViewData["Title"] = "Refunds"; bool all = ViewBag.All == true; }
<div class="d-flex justify-content-between align-items-center">
    <h3>Refunds</h3>
    <a asp-action="Index" asp-route-all="@(!all)">@(all ? "Show pending only" : "Show all")</a>
</div>
<table class="table table-sm align-middle">
    <thead><tr><th>#</th><th>PNR</th><th>Agency</th><th class="text-end">Refund (BDT)</th><th class="text-end">Penalty</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr><td>@r.Id</td><td>@r.Pnr</td><td>@r.AgencyName</td><td class="text-end">@r.RefundAmount.ToString("N0")</td><td class="text-end">@r.Penalty.ToString("N0")</td>
            <td><partial name="_StatusBadge" model="r.Status.ToString()" /></td>
            <td>@if (r.Status == RefundStatus.Pending)
                {
                    <form asp-action="Approve" asp-route-id="@r.Id" method="post"><button class="btn btn-sm btn-success">Approve</button></form>
                }</td></tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="text-muted">Nothing here.</p> }
