@model AdminBookingSearchViewModel
@{ ViewData["Title"] = "All bookings"; }
<h3>All bookings</h3>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><select asp-for="AgentId" class="form-select">
        <option value="">All agents</option>
        @foreach (var a in Model.Agents) { <option value="@a.Id" selected="@(Model.AgentId == a.Id)">@a.Code &ndash; @a.AgencyName</option> }
    </select></div>
    <div class="col-md-2"><select asp-for="Status" class="form-select">
        <option value="">Any status</option>
        @foreach (var s in Enum.GetNames<BookingStatus>()) { <option value="@s" selected="@(Model.Status == s)">@s</option> }
    </select></div>
    <div class="col-md-2"><input asp-for="Pnr" class="form-control" placeholder="PNR" maxlength="6" /></div>
    <div class="col-md-2"><input asp-for="From" type="date" class="form-control" /></div>
    <div class="col-md-2"><input asp-for="To" type="date" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary">Search</button></div>
</form>
<table class="table table-sm table-striped">
    <thead><tr><th>PNR</th><th>Agency</th><th>Supplier</th><th>Status</th><th class="text-end">Total (BDT)</th><th>Created (UTC)</th></tr></thead>
    <tbody>
    @foreach (var b in Model.Rows)
    {
        <tr><td>@b.Pnr</td><td>@b.AgencyName</td><td>@b.Supplier</td><td><partial name="_StatusBadge" model="b.Status" /></td>
            <td class="text-end">@b.TotalFare.ToString("N0")</td><td>@b.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
    }
    </tbody>
</table>
<div class="d-flex justify-content-between">
    <span class="text-muted">@Model.TotalCount booking(s) &middot; page @Model.Page</span>
    <div>
        @if (Model.Page > 1) { <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["AgentId"] = Model.AgentId?.ToString(), ["Status"] = Model.Status, ["Pnr"] = Model.Pnr, ["From"] = Model.From?.ToString("yyyy-MM-dd"), ["To"] = Model.To?.ToString("yyyy-MM-dd"), ["Page"] = (Model.Page - 1).ToString() })">Previous</a> }
        @if (Model.HasNext) { <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["AgentId"] = Model.AgentId?.ToString(), ["Status"] = Model.Status, ["Pnr"] = Model.Pnr, ["From"] = Model.From?.ToString("yyyy-MM-dd"), ["To"] = Model.To?.ToString("yyyy-MM-dd"), ["Page"] = (Model.Page + 1).ToString() })">Next</a> }
    </div>
</div>
