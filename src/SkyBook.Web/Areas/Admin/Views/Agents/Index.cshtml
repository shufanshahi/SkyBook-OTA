@model AgentListViewModel
@{ ViewData["Title"] = "Agents"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Agents</h3>
    <a class="btn btn-primary" asp-action="Create">New agent</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Name or code" /></div>
    <div class="col-md-2"><select name="status" class="form-select">
        <option value="">Any status</option>
        <option value="Active" selected="@(Model.Status == "Active")">Active</option>
        <option value="Suspended" selected="@(Model.Status == "Suspended")">Suspended</option>
    </select></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div>
</form>
<table class="table table-sm align-middle">
    <thead><tr><th>Code</th><th>Agency</th><th>Status</th><th class="text-end">Wallet</th><th class="text-end">Credit</th><th>Markup %</th><th>Top-up</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model.Agents)
    {
        <tr>
            <td>@a.Code</td><td>@a.AgencyName</td>
            <td><partial name="_StatusBadge" model="a.Status" /></td>
            <td class="text-end">@a.WalletBalance.ToString("N0")</td>
            <td class="text-end">@a.CreditLimit.ToString("N0")</td>
            <td>
                <form asp-action="Markup" asp-route-id="@a.Id" method="post" class="d-flex gap-1">
                    <input name="markupPercent" type="number" step="0.5" min="0" max="50" value="@a.MarkupPercent.ToString("0.##")" class="form-control form-control-sm" style="width:5rem" />
                    <button class="btn btn-sm btn-outline-secondary">Save</button>
                </form>
            </td>
            <td>
                <form asp-action="TopUp" asp-route-id="@a.Id" method="post" class="d-flex gap-1">
                    <input name="amount" type="number" step="100" min="1" placeholder="Amount" class="form-control form-control-sm" style="width:7rem" required />
                    <input name="reference" placeholder="Reference" class="form-control form-control-sm" style="width:8rem" />
                    <button class="btn btn-sm btn-outline-primary">Add</button>
                </form>
            </td>
            <td>
                <form asp-action="Status" asp-route-id="@a.Id" method="post">
                    <input type="hidden" name="active" value="@(a.Status == "Active" ? "false" : "true")" />
                    <button class="btn btn-sm @(a.Status == "Active" ? "btn-outline-danger" : "btn-outline-success")">@(a.Status == "Active" ? "Suspend" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
