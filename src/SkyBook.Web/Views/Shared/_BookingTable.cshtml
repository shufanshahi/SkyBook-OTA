@model IReadOnlyList<SkyBook.Infrastructure.Queries.BookingRow>
@if (!Model.Any())
{
    <p class="text-muted">No bookings yet.</p>
}
else
{
    <table class="table table-sm table-striped align-middle">
        <thead><tr><th>PNR</th><th>Supplier</th><th>Status</th><th class="text-end">Total (BDT)</th><th>Created (UTC)</th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td><a asp-area="" asp-controller="Bookings" asp-action="Details" asp-route-pnr="@b.Pnr">@b.Pnr</a></td>
                <td>@b.Supplier</td>
                <td><partial name="_StatusBadge" model="b.Status" /></td>
                <td class="text-end">@b.TotalFare.ToString("N0")</td>
                <td>@b.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}
