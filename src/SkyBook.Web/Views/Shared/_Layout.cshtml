<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyBook</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SkyBook</a>
            <ul class="navbar-nav me-auto">
                @if (User.IsInRole("Agent"))
                {
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Flights" asp-action="Search">Search</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Bookings" asp-action="Index">My Bookings</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Agents" asp-action="Index">Agents</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Bookings" asp-action="Index">All Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Refunds" asp-action="Index">Refunds</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Sales">Sales</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="SupplierLogs" asp-action="Index">Supplier Logs</a></li>
                }
            </ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
                    <span class="navbar-text me-3">@User.Identity.Name (@(User.IsInRole("Admin") ? "Admin" : "Agent"))</span>
                    <button class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            }
        </div>
    </nav>
    <div class="container pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
