@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

@if (Model.IsAdmin)
{
    <h2>Admin dashboard</h2>
    <div class="row g-3 mt-1">
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Agents</div><div class="fs-2">@Model.AgentCount</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Bookings today</div><div class="fs-2">@Model.BookingsToday</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Pending refunds</div><div class="fs-2">@Model.PendingRefunds</div>
            <a asp-area="Admin" asp-controller="Refunds" asp-action="Index">Review</a></div></div></div>
    </div>
}
else
{
    <h2>@Model.Agent?.AgencyName</h2>
    @if (Model.Agent?.Status != "Active")
    {
        <div class="alert alert-danger">This agency is suspended. Searching and booking are disabled.</div>
    }
    <div class="row g-3 mt-1">
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Wallet balance</div><div class="fs-2">BDT @Model.Agent?.WalletBalance.ToString("N0")</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Credit limit</div><div class="fs-2">BDT @Model.Agent?.CreditLimit.ToString("N0")</div></div></div></div>
        <div class="col-md-4"><div class="card"><div class="card-body d-flex align-items-center justify-content-center h-100">
            <a class="btn btn-primary btn-lg" asp-controller="Flights" asp-action="Search">Search flights</a></div></div></div>
    </div>
    <h5 class="mt-4">Recent bookings</h5>
    <partial name="_BookingTable" model="Model.Recent" />
}
